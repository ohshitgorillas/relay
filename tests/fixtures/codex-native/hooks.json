{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {"type": "command", "command": "python3 /synthetic/native_guard.py"},
          {"type": "command", "command": "python3 '/synthetic/hook scripts/claude_adapter.py' --scope relay"}
        ]
      },
      {
        "matcher": "Edit|Write",
        "hooks": [
          {"type": "command", "command": "/synthetic/claude_adapter.py --scope relay"},
          {"type": "command", "command": "python3 /synthetic/claude_adapter.py.backup"}
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {"type": "command", "command": "python3 /synthetic/claude_adapter.py --scope relay"}
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {"type": "command", "command": "python3 /synthetic/session_notice.py"}
        ]
      }
    ]
  }
}
